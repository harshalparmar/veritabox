# ── Core ────────────────────────────────────────────────────────────────
# Set to "production" on your deployed server.
NODE_ENV=development
PORT=5000

# MongoDB connection string. Use credentials + TLS in production.
MONGO_URI=mongodb://127.0.0.1:27017/your_db

# Signing secrets — MUST be strong, random, and unique per environment.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SA_JWT_SECRET=

# Comma-separated list of allowed frontend origins (REQUIRED in production).
# Example: https://app.example.com,https://www.example.com
FRONTEND_URL=

# ── OAuth providers (optional; leave blank to disable a provider) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Email (Plunk) ────────────────────────────────────────────────────────
PLUNK_PUBLIC_API_KEY=
PLUNK_SECRET_API_KEY=

# ── Redis (required for rate limiting, caching, Socket.IO adapter) ────
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# ── Judge0 (self-hosted code execution engine) ───────────────────────
JUDGE0_API_URL=http://localhost:2358

# ── AI ───────────────────────────────────────────────────────────────────
# ── Encryption ──────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ── AI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
