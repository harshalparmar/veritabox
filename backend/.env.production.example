# ── Production Backend Environment ──────────────────────────────────────
# Copy this to .env on your VPS and fill in all values.
# NEVER commit the real .env file.

NODE_ENV=production
PORT=5000

# MongoDB — use the docker-compose internal hostname in production
MONGO_URI=mongodb://MONGO_USER:MONGO_PASSWORD@veritabox_mongo:27017/veritabox?authSource=admin

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SA_JWT_SECRET=

# Allowed frontend origins (REQUIRED in production)
FRONTEND_URL=https://veritabox.com,https://www.veritabox.com

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email (Plunk)
PLUNK_PUBLIC_API_KEY=
PLUNK_SECRET_API_KEY=

# Redis — use docker-compose internal hostname
REDIS_URL=redis://:REDIS_PASSWORD@veritabox_redis:6379/0

# Code execution
JUDGE0_API_URL=http://veritabox_piston:2000

# Encryption key for TOTP secrets etc.
ENCRYPTION_KEY=

# AI
OPENAI_API_KEY=
