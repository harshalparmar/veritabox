# Frontend build-time config. Everything here is PUBLIC (bundled into the
# client), so never put secrets in this file — only OAuth *client IDs* and
# public URLs. Client secrets belong in the backend .env only.

# Base URL of the backend API. Example: https://api.example.com
VITE_API_URL=http://localhost:5000

# OAuth client IDs (public identifiers, safe to expose).
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_LINKEDIN_CLIENT_ID=
